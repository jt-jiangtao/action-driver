node_modules/
out/
dist/
apps/agent-runtime/native/
coverage/
playwright-report/
test-results/
.superpowers/
.DS_Store
*.log
apps/agent-runtime/.runtime-cache/

# Vendored Codex Computer Use packages (internal use only, not for release) keep their dist/ and bundled node_modules/
!apps/agent-runtime/vendor/codex-cua/**/dist/
!apps/agent-runtime/vendor/codex-cua/**/node_modules/

# Preserve complete original package backups, including build output and bundled dependencies.
!packages/back/**

# Swift build output from running swift at the repository root
/.build/

# Track the two Fork sources; keep toolchains and build artifacts local.
/thridparty/*
!/thridparty/playwright/
!/thridparty/electron/

# Native sources and platform artifacts belong to the Computer Use plugin
plugins/computer-use/native/.build/
