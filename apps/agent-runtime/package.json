{
  "name": "@actiondriver/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/runtime-entry.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:better-sqlite3 --external:electron --external:pino --external:pino-pretty --external:ws && node scripts/copy-rg.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@actiondriver/contracts": "workspace:*",
    "@actiondriver/model-connections": "workspace:*",
    "@actiondriver/observability": "workspace:*",
    "@actiondriver/runtime-contracts": "workspace:*",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.16",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "12.11.1",
    "inversify": "8.2.3",
    "pino": "9.5.0",
    "reflect-metadata": "0.2.2",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "pino-pretty": "13.0.0"
  }
}
