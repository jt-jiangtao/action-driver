{
  "name": "@actiondriver/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/runtime-entry.ts --bundle --platform=node --format=esm --banner:js='import { createRequire as __actionDriverCreateRequire } from \"node:module\"; const require = __actionDriverCreateRequire(import.meta.url);' --outfile=dist/index.js --external:better-sqlite3 --external:electron --external:ws && node scripts/copy-rg.mjs && node scripts/stage-runtimes.mjs && node scripts/copy-system-skills.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@actiondriver/activity-projection": "workspace:*",
    "@actiondriver/contracts": "workspace:*",
    "@actiondriver/model-connections": "workspace:*",
    "@actiondriver/observability": "workspace:*",
    "@actiondriver/runtime-contracts": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.16",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@opentelemetry/api": "1.9.1",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "12.11.1",
    "file-type": "20.5.0",
    "hono": "4.11.7",
    "image-size": "2.0.4",
    "openai": "6.49.0",
    "ws": "8.21.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2"
  }
}
