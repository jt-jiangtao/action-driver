{
  "name": "@action-driver/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "corepack pnpm --filter @action-driver/agent-runtime build && corepack pnpm --dir ../.. build:native:computer-use",
    "dev": "node ../../scripts/run-desktop-electron.mjs dev",
    "prebuild": "corepack pnpm --dir ../.. validate:e2e-interactions",
    "build": "electron-vite build",
    "build:visual": "electron-vite build --mode visual",
    "preview": "node ../../scripts/run-desktop-electron.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@action-driver/activity-projection": "workspace:*",
    "@action-driver/browser-desktop": "workspace:*",
    "@action-driver/browser-runtime": "workspace:*",
    "@action-driver/command-plugin": "workspace:*",
    "@action-driver/computer-use-plugin": "workspace:*",
    "@action-driver/contracts": "workspace:*",
    "@action-driver/image-generation-plugin": "workspace:*",
    "@action-driver/model-connections": "workspace:*",
    "@action-driver/observability": "workspace:*",
    "@action-driver/plugin-contracts": "workspace:*",
    "@action-driver/plugin-sdk": "workspace:*",
    "@action-driver/runtime-contracts": "workspace:*",
    "@action-driver/skills-plugin": "workspace:*",
    "@action-driver/web-plugin": "workspace:*",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.100.6",
    "antd": "6.6.4",
    "lucide-react": "1.47.0",
    "markdown-it": "^15.0.2",
    "monaco-editor": "0.52.2",
    "playwright-core": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "slate": "0.126.2",
    "slate-react": "0.126.4",
    "ws": "8.21.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "38.8.6",
    "electron-vite": "3.1.0"
  }
}
