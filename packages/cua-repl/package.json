{
  "name": "@actiondriver/cua-repl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ActionDriver-owned CUA REPL host: loads the macOS instruction resources and launches the REPL process against ActionDriver browser and computer service modules.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cua-repl": "bin/cua-repl.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "bin",
    "dist",
    "plugin",
    "resources",
    "docs"
  ],
  "dependencies": {
    "@actiondriver/cua": "workspace:*"
  }
}
