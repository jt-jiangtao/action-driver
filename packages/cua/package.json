{
  "name": "@action-driver/cua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Action-Driver-owned CUA implementation: macOS computer sessions, app/window discovery, browser tab sessions and documentation readers, reconstructed to replace the original @oai/cua bundle.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tinysky-alt": {
      "types": "./dist/tinysky-alt.d.ts",
      "import": "./dist/tinysky-alt.js"
    },
    "./computer": {
      "types": "./dist/computer-entry.d.ts",
      "import": "./dist/computer-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "resources",
    "docs"
  ],
  "dependencies": {
    "@action-driver/browser-runtime": "workspace:*",
    "@action-driver/sky": "workspace:*"
  }
}
