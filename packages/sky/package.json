{
  "name": "@action-driver/sky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Action-Driver-owned macOS Sky client: native-pipe transport, RPC framing, computer-use policy and telemetry, reconstructed to replace the original @oai/sky bundle.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./action-driver": {
      "types": "./dist/mac/action-driver-host.d.ts",
      "import": "./dist/mac/action-driver-host.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@statsig/js-client": "3.32.6"
  },
  "files": [
    "dist",
    "resources",
    "docs"
  ],
  "devDependencies": {
    "@action-driver/runtime-contracts": "workspace:*"
  }
}
