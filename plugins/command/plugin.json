{
  "id": "command",
  "version": "1.2.0",
  "sdk": "^1.0.0",
  "entry": "dist/extension.js",
  "catalog": "dist/catalog.js",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "activation": [
    "onTool:tools.local.command.shell.run",
    "onTool:tools.local.command.python.run",
    "onTool:tools.local.command.node.run",
    "onTool:tools.local.command.typescript.run",
    "onTool:tools.local.command.dependencies.load"
  ],
  "contributions": [
    {
      "kind": "tool",
      "id": "tools.local.command.shell.run",
      "modelName": "tools.local.command.shell.run"
    },
    {
      "kind": "tool",
      "id": "tools.local.command.python.run",
      "modelName": "tools.local.command.python.run"
    },
    {
      "kind": "tool",
      "id": "tools.local.command.node.run",
      "modelName": "tools.local.command.node.run"
    },
    {
      "kind": "tool",
      "id": "tools.local.command.typescript.run",
      "modelName": "tools.local.command.typescript.run"
    },
    {
      "kind": "tool",
      "id": "tools.local.command.dependencies.load",
      "modelName": "tools.local.command.dependencies.load"
    }
  ],
  "dependencies": [],
  "requires": [
    "host.command.execute"
  ]
}
