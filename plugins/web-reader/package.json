{
  "name": "@actiondriver/web-reader-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/extension.ts",
    "./catalog": "./src/catalog.ts",
    "./execution": "./src/execution.ts"
  },
  "files": [
    "dist",
    "plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@actiondriver/plugin-sdk": "workspace:*",
    "ipaddr.js": "2.5.0",
    "@mozilla/readability": "0.6.0",
    "jsdom": "26.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7"
  }
}
